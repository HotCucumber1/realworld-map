    <!-- Backup -->
    <string name="backup_title">Экспорт и импорт</string>
    <string name="backup_export">Экспортировать всё</string>
    <string name="backup_export_desc">ZIP-архив со всеми маршрутами, GPS-точками, исследованной территорией и настройками.</string>
    <string name="backup_import">Импортировать из файла</string>
    <string name="backup_import_desc">Файл проверяется целиком перед изменением данных. При ошибке ничего не меняется.</string>
    <string name="backup_transfer_title">Перенос на другой телефон</string>
    <string name="backup_transfer_text">1. Экспортируйте данные здесь и передайте файл (облако, мессенджер, кабель).\n2. Установите World Explorer на новый телефон.\n3. Откройте «Экспорт и импорт» → «Импортировать» и выберите файл.</string>
    <string name="backup_working">Подождите…</string>
    <string name="backup_export_done">Экспорт завершён: %1$d маршрутов, %2$d точек, %3$d ячеек</string>
    <string name="backup_inspect_title">Резервная копия</string>
    <string name="backup_inspect_text">Создана: %1$s\nВерсия приложения: %2$s\nМаршрутов: %3$d\nGPS-точек: %4$d\nИсследованных ячеек: %5$d</string>
    <string name="backup_merge">Объединить</string>
    <string name="backup_merge_desc">Добавить недостающее к данным на телефоне. Ничего не удаляется; совпадающие маршруты берутся в более новой версии.</string>
    <string name="backup_replace">Заменить</string>
    <string name="backup_replace_desc">Удалить данные на телефоне и восстановить их из файла, включая настройки.</string>
    <string name="backup_replace_confirm_title">Заменить локальные данные?</string>
    <string name="backup_replace_confirm_text">Все маршруты и исследованная территория на этом телефоне будут удалены и заменены данными из файла. Перед заменой приложение сохранит копию текущих данных во внутреннюю память.</string>
    <string name="backup_replace_confirm_check">Я понимаю, что текущие данные будут заменены</string>
    <string name="backup_replace_suggest_export">Сначала экспортировать текущие данные</string>
    <string name="backup_import_done">Импорт завершён</string>
    <string name="backup_import_summary">Маршруты: +%1$d, обновлено %2$d, без изменений %3$d\nТочки: +%4$d, дубликатов %5$d\nЯчейки: +%6$d, уже открыто %7$d</string>
    <string name="backup_safety_copy">Копия прежних данных: %1$s</string>
    <string name="backup_import_while_tracking">Остановите запись маршрута перед импортом</string>

